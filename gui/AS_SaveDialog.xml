<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="1080px 620px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="$l10n_as_save_avatar" id="dialogTitleElement" position="0px -30px" />

            <GuiElement position="45px -70px" size="600px 480px">
                <Text profile="asHeaderLeft" id="presetIdHeaderText" position="0px 0px" size="570px 32px" text="$l10n_as_preset_id" />
                <Button profile="asInputFieldButton" id="idField" position="0px -36px" size="570px 40px" text="$l10n_as_preset_id" onClick="onClickIdField" />

                <Text profile="asHeaderLeft" id="displayNameHeaderText" position="0px -84px" size="570px 32px" text="$l10n_as_display_name" />
                <Button profile="asInputFieldButton" id="displayNameField" position="0px -120px" size="570px 40px" text="$l10n_as_display_name" onClick="onClickDisplayNameField" />

                <Text profile="asHeaderLeft" id="categoryHeaderText" position="0px -168px" size="570px 32px" text="$l10n_as_category" />

                <SmoothList profile="asList" id="categoryTable" position="0px -204px" size="550px 118px" handleFocus="true" selectedWithoutFocus="true">
                    <ListItem profile="asListItem" name="categoryRowTemplate" size="550px 38px">
                        <Text profile="asRowCellLeft" position="12px 0px" size="520px 38px" name="CategoryName" />
                    </ListItem>
                </SmoothList>
                <ThreePartBitmap profile="fs25_listSliderBox" position="556px -204px" size="12px 118px">
                    <Slider profile="fs25_listSlider" size="6px 110px" dataElementId="categoryTable" id="categorySlider" />
                </ThreePartBitmap>

                <Text profile="asHeaderLeft" id="newCategoryHeaderText" position="0px -332px" size="570px 32px" text="$l10n_as_new_category_optional" />
                <Button profile="asInputFieldButton" id="newCategoryField" position="0px -368px" size="570px 40px" text="$l10n_as_new_category_optional" onClick="onClickNewCategoryField" />

                <Text profile="asMetaText" id="validationText" position="0px -416px" size="570px 44px" text="$l10n_as_save_instructions" textMaxNumLines="2" />
            </GuiElement>

            <GuiElement position="665px -70px" size="330px 480px">
                <Text profile="asHeaderLeft" id="helpHeaderText" position="0px 0px" size="310px 32px" text="$l10n_as_help" />
                <Text profile="asHeaderLeft" id="helpTitleText" position="0px -55px" size="310px 38px" text="$l10n_as_preset_id" />
                <Text profile="asMetaText" id="helpBodyText" position="0px -100px" size="310px 300px" text="" textVerticalAlignment="top" textMaxNumLines="16" />
            </GuiElement>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" size="1030px 60px">
            <Button profile="buttonBack" id="cancelButton" text="$l10n_as_cancel" onClick="onClickBack" />
            <Button profile="asButtonSaveEnter" id="saveButton" text="$l10n_as_save" onClick="onClickSave" />
        </BoxLayout>
    </GuiElement>
</GUI>
