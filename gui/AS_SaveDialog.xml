<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="1120px 650px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="$l10n_as_save_avatar" id="dialogTitleElement" position="0px -30px" />

            <GuiElement position="45px -85px" size="620px 500px">
                <Bitmap profile="asHeaderBox" position="0px 0px" size="600px 38px">
                    <Text profile="asHeaderLeft" id="presetIdHeaderText" position="10px 0px" size="570px 36px" text="$l10n_as_preset_id" />
                    <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
                </Bitmap>
                <Button profile="asInputFieldButton" id="idField" position="0px -43px" size="600px 44px" text="$l10n_as_preset_id" onClick="onClickIdField" />

                <Bitmap profile="asHeaderBox" position="0px -100px" size="600px 38px">
                    <Text profile="asHeaderLeft" id="displayNameHeaderText" position="10px 0px" size="570px 36px" text="Display Name" />
                    <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
                </Bitmap>
                <Button profile="asInputFieldButton" id="displayNameField" position="0px -143px" size="600px 44px" text="Display Name" onClick="onClickDisplayNameField" />

                <Bitmap profile="asHeaderBox" position="0px -200px" size="600px 38px">
                    <Text profile="asHeaderLeft" id="categoryHeaderText" position="10px 0px" size="570px 36px" text="$l10n_as_category" />
                    <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
                </Bitmap>
                <MultiTextOption profile="fs25_multiTextOption" id="categoryOption" position="0px -243px" size="600px 44px" texts="Custom" onClick="onClickCategoryOption" wrap="false" />

                <Bitmap profile="asHeaderBox" id="newCategoryHeaderBox" position="0px -300px" size="600px 38px" visible="false">
                    <Text profile="asHeaderLeft" id="newCategoryHeaderText" position="10px 0px" size="570px 36px" text="New Category" visible="false" />
                    <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
                </Bitmap>
                <Button profile="asInputFieldButton" id="newCategoryField" position="0px -343px" size="600px 44px" text="New Category" onClick="onClickNewCategoryField" visible="false" />

                <Bitmap profile="asDetailBox" position="0px -405px" size="600px 58px">
                    <Text profile="asMetaText" id="validationText" position="12px -4px" size="576px 50px" text="$l10n_as_save_instructions" textMaxNumLines="2" />
                </Bitmap>
            </GuiElement>

            <GuiElement position="700px -85px" size="330px 500px">
                <Bitmap profile="asDetailBox" position="0px 0px" size="330px 463px">
                    <Text profile="asHeaderLeft" id="helpHeaderText" position="18px -10px" size="294px 34px" text="Help" />
                    <ThreePartBitmap profile="fs25_contractsContentSeparator" position="18px -52px" size="294px 2px" />
                    <Text profile="asHeaderLeft" id="helpTitleText" position="18px -70px" size="294px 38px" text="Preset ID" />
                    <Text profile="asMetaText" id="helpBodyText" position="18px -118px" size="294px 320px" text="" textVerticalAlignment="top" textMaxNumLines="14" />
                </Bitmap>
            </GuiElement>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" size="1070px 60px">
            <Button profile="buttonBack" id="cancelButton" text="$l10n_as_cancel" onClick="onClickBack" />
            <Button profile="asButtonSaveEnter" id="saveButton" text="$l10n_as_save" onClick="onClickSave" />
        </BoxLayout>
    </GuiElement>
</GUI>
