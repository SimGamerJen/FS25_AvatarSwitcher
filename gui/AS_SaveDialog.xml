<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="760px 500px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="$l10n_as_save_avatar" id="dialogTitleElement" position="0px -30px" />

            <Bitmap profile="asHeaderBox" position="55px -85px" size="650px 42px">
                <Text profile="asHeaderLeft" id="presetIdHeaderText" position="10px 0px" size="620px 40px" text="$l10n_as_preset_id" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
            </Bitmap>
            <Button profile="asInputFieldButton" id="idField" position="55px -132px" size="650px 46px" text="$l10n_as_preset_id" onClick="onClickIdField" />

            <Bitmap profile="asHeaderBox" position="55px -185px" size="650px 42px">
                <Text profile="asHeaderLeft" id="descriptionHeaderText" position="10px 0px" size="620px 40px" text="$l10n_as_description" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
            </Bitmap>
            <Button profile="asInputFieldButton" id="descriptionField" position="55px -232px" size="650px 46px" text="$l10n_as_description" onClick="onClickDescriptionField" />

            <Bitmap profile="asHeaderBox" position="55px -285px" size="650px 42px">
                <Text profile="asHeaderLeft" id="categoryHeaderText" position="10px 0px" size="620px 40px" text="$l10n_as_category" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
            </Bitmap>
            <Button profile="asInputFieldButton" id="categoryField" position="55px -332px" size="650px 46px" text="custom" onClick="onClickCategoryField" />

            <Bitmap profile="asDetailBox" position="55px -382px" size="650px 34px">
                <Text profile="asMetaText" id="messageText" position="10px 0px" size="630px 28px" text="$l10n_as_save_instructions" textLayoutMode="scrolling" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
            </Bitmap>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" size="710px 60px">
            <Button profile="buttonBack" id="cancelButton" text="$l10n_as_cancel" onClick="onClickBack" />
            <Button profile="asButtonSaveEnter" id="saveButton" text="$l10n_as_save" onClick="onClickSave" />
        </BoxLayout>
    </GuiElement>
</GUI>
