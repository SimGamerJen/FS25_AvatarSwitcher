<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUIProfiles>
    <Presets>
        <Preset name="colorWhite" value="1 1 1 1"/>
        <Preset name="colorListHeaderBackground" value="0 0 0 0.35" />
    </Presets>

    <Profile name="asHeaderLeft" extends="baseReference" with="anchorTopLeft pivotTopLeft">
        <imageColor value="0 0 0 0" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textHighlightedColor value="$preset_fs25_colorMainHighlight" />
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_colorWhite_50" />
        <textAlignment value="left" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>

    <Profile name="asHeaderRight" extends="asHeaderLeft">
        <textAlignment value="right" />
    </Profile>

    <Profile name="asList" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft" />

    <!-- Retained for compatibility, but new dialogs no longer render these as Bitmap elements. -->
    <Profile name="asHeaderBox" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
        <imageSliceId value="gui.empty"/>
        <imageColor value="$preset_colorListHeaderBackground"/>
    </Profile>

    <Profile name="asDetailBox" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
        <imageSliceId value="gui.empty"/>
        <imageColor value="0 0 0 0.45"/>
    </Profile>

    <Profile name="asListItem" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="40px"/>
        <imageColor value="$preset_fs25_colorGrey" />
        <imageSelectedColor value="$preset_fs25_colorMainHighlight" />
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50" />
    </Profile>

    <Profile name="asRowCellLeft" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="false" />
        <textSize value="15px" />
        <textAlignment value="left" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainDark" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>

    <Profile name="asRowCellRight" extends="asRowCellLeft">
        <textAlignment value="right" />
    </Profile>

    <Profile name="asMetaText" extends="baseReference" with="anchorTopLeft pivotTopLeft">
        <imageColor value="0 0 0 0" />
        <textSize value="15px" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textDisabledColor value="$preset_colorDisabled" />
        <textAlignment value="left" />
    </Profile>

    <!-- Use the known blank GUI slice instead of noSlice, which can expose the full UI atlas. -->
    <Profile name="asInputFieldButton" extends="buttonBase" with="anchorTopLeft pivotTopLeft">
        <height value="45px"/>
        <imageSliceId value="gui.empty"/>
        <imageColor value="0.07 0.075 0.08 0.96"/>
        <imageFocusedColor value="0.11 0.13 0.15 0.98"/>
        <imageHighlightedColor value="0.11 0.13 0.15 0.98"/>
        <imageSelectedColor value="0.11 0.13 0.15 0.98"/>
        <imagePressedColor value="0.11 0.13 0.15 0.98"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textFocusedColor value="$preset_fs25_colorMainLight"/>
        <textHighlightedColor value="$preset_fs25_colorMainLight"/>
        <textSelectedColor value="$preset_fs25_colorMainLight"/>
        <textPressedColor value="$preset_fs25_colorMainLight"/>
        <textSize value="15px"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
        <textOffset value="12px 0px"/>
        <inputAction value=""/>
        <clickSound value="DEFAULT_CLICK"/>
        <sendActionOnRelease value="true"/>
    </Profile>

    <Profile name="asButtonDelete" extends="buttonExtra1">
        <inputAction value="MENU_CANCEL" />
    </Profile>

    <Profile name="asButtonSaveEnter" extends="buttonExtra1">
        <inputAction value="MENU_ACCEPT" />
    </Profile>

</GUIProfiles>
