<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="1170px 650px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="$l10n_as_title" id="dialogTitleElement" position="0px -30px" />

            <Bitmap profile="asHeaderBox" id="categoryHeaderBox" position="45px -90px" size="330px 50px">
                <Text profile="asHeaderLeft" id="categoryHeaderText" position="10px 0px" size="280px 40.77px" text="$l10n_as_category" />
            </Bitmap>

            <SmoothList profile="asList" id="categoryTable" position="50px -145px" size="320px 330px" focusInit="onOpen" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="asListItem" name="categoryRowTemplate" size="320px 40.77px">
                    <Text profile="asRowCellLeft" position="12px 0px" size="250px 40.77px" name="CategoryName" />
                    <Text profile="asRowCellRight" position="260px 0px" size="48px 40.77px" name="CategoryCount" />
                </ListItem>
            </SmoothList>

            <ThreePartBitmap profile="fs25_listSliderBox" position="380px -145px" size="12px 330px">
                <Slider profile="fs25_listSlider" size="6px 322px" dataElementId="categoryTable" id="categorySlider" />
            </ThreePartBitmap>

            <Bitmap profile="asHeaderBox" id="presetHeaderBox" position="420px -90px" size="690px 50px">
                <Text profile="asHeaderLeft" id="appearanceHeaderText" position="10px 0px" size="300px 40.77px" text="$l10n_as_appearance" />
                <Text profile="asHeaderRight" id="presetIdHeaderText" position="500px 0px" size="175px 40.77px" text="$l10n_as_preset_id" />
            </Bitmap>

            <SmoothList profile="asList" id="presetTable" handleFocus="true" selectedWithoutFocus="false" position="425px -145px" size="680px 330px" focusChangeTop="nil" focusChangeBottom="nil">
                <ListItem profile="asListItem" name="presetRowTemplate" size="680px 40.77px">
                    <Text profile="asRowCellLeft" position="12px 0px" size="450px 40.77px" name="PresetName" textLayoutMode="scrolling" />
                    <Text profile="asRowCellRight" position="490px 0px" size="175px 40.77px" name="PresetId" textLayoutMode="scrolling" />
                </ListItem>
            </SmoothList>

            <ThreePartBitmap profile="fs25_listSliderBox" position="1115px -145px" size="12px 330px">
                <Slider profile="fs25_listSlider" size="6px 322px" dataElementId="presetTable" id="presetSlider" />
            </ThreePartBitmap>

            <Bitmap profile="asDetailBox" id="detailBox" position="45px -515px" size="1065px 55px">
                <Text profile="asMetaText" id="detailText" position="10px 0px" size="1045px 45px" text="$l10n_as_select_saved_appearance" textLayoutMode="scrolling" />
            </Bitmap>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" size="1120px 60px">
            <Button profile="buttonBack" id="closeButton" text="$l10n_as_close" onClick="onClickBack" />
            <Button profile="buttonExtra1" id="applyButton" text="$l10n_as_apply" onClick="onClickApply" />
            <Button profile="asButtonDelete" id="deleteButton" text="$l10n_as_delete" onClick="onClickDelete" />
        </BoxLayout>
    </GuiElement>
</GUI>
